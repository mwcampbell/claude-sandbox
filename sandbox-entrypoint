#!/bin/sh
# Entrypoint for the claude-sandbox image: starts the Docker daemon, then
# execs the requested command as the agent user.
#
# smolvm packs don't carry the image's USER or ENV, so under smolvm this
# starts as root with a bare environment. It restores the image's environment
# from /etc/sandbox-env (written at build time) and drops to the agent user
# itself. Started as agent (e.g. by `docker run`), it uses sudo where it needs
# root.
#
# In container mode the launcher sets SANDBOX_DOCKER=0: there's no dockerd,
# since that would need a privileged container.
#
# Under smolvm the image's root filesystem is an overlay, and Docker's own
# overlay2 snapshotter can't stack on top of that. The machine's ext4 data
# disk is mounted at /workspace, so Docker's and containerd's state get
# bind-mounted from there.

set -u

AGENT=agent
DATA_DISK=/workspace

if [ "$(id -u)" = 0 ]; then
    as_root() { "$@"; }
else
    as_root() { sudo "$@"; }
fi

start_dockerd() {
    if as_root docker info >/dev/null 2>&1; then
        return 0
    fi

    if [ "$(stat -f -c %T "$DATA_DISK" 2>/dev/null)" = "ext2/ext3" ]; then
        for d in docker containerd; do
            as_root mkdir -p "$DATA_DISK/.sandbox/$d" "/var/lib/$d"
            mountpoint -q "/var/lib/$d" ||
                as_root mount --bind "$DATA_DISK/.sandbox/$d" "/var/lib/$d"
        done
    else
        echo "sandbox: $DATA_DISK is not an ext4 disk; Docker may fail to start" >&2
    fi

    as_root rm -f /var/run/docker.pid /run/containerd/containerd.pid
    as_root sh -c 'setsid dockerd >/var/log/dockerd.log 2>&1 &'

    i=0
    while [ $i -lt 30 ]; do
        as_root docker info >/dev/null 2>&1 && return 0
        sleep 1
        i=$((i + 1))
    done
    echo "sandbox: dockerd did not come up; see /var/log/dockerd.log" >&2
    return 1
}

# smolvm names every guest "container" without a matching hosts entry, which
# makes sudo complain on every call
if ! grep -q "[[:space:]]$(hostname)\$" /etc/hosts; then
    as_root sh -c "echo '127.0.1.1 $(hostname)' >> /etc/hosts"
fi

if [ "${SANDBOX_DOCKER:-1}" = 1 ]; then
    start_dockerd
fi

home=$(getent passwd "$AGENT" | cut -d: -f6)

# The rest runs as whoever started this: root in a VM, or in a container,
# agent, whose uid is the host user's. The latter matters for the files
# handed back in the profile directory, which the launcher must be able to
# read and delete.

# Write a .gitconfig handed in by the launcher (a single file can't be mounted)
if [ -n "${SANDBOX_GITCONFIG_B64:-}" ]; then
    printf '%s' "$SANDBOX_GITCONFIG_B64" | base64 -d >"$home/.gitconfig"
    chown "$AGENT:$AGENT" "$home/.gitconfig"
fi
unset SANDBOX_GITCONFIG_B64 SANDBOX_DOCKER

# A login profile, when the launcher passes one, is a directory holding
# Claude Code's credentials and ~/.claude.json. They're installed before the
# command runs and copied back to $profile/out when it exits, so the launcher
# can keep a refreshed login. Nothing else from ~/.claude leaves the sandbox.
profile=${SANDBOX_PROFILE_DIR:-}
unset SANDBOX_PROFILE_DIR

if [ -n "$profile" ]; then
    install -d -o "$AGENT" -g "$AGENT" -m 700 "$home/.claude"
    [ -f "$profile/credentials.json" ] &&
        install -o "$AGENT" -g "$AGENT" -m 600 "$profile/credentials.json" "$home/.claude/.credentials.json"
    [ -f "$profile/claude.json" ] &&
        install -o "$AGENT" -g "$AGENT" -m 600 "$profile/claude.json" "$home/.claude.json"
fi

if [ "$(id -u)" = 0 ]; then
    set -a
    . /etc/sandbox-env
    set +a
    export HOME="$home" USER="$AGENT" LOGNAME="$AGENT" SHELL=/usr/bin/zsh
    set -- setpriv --reuid="$AGENT" --regid="$AGENT" --init-groups -- "$@"
fi

if [ -z "$profile" ]; then
    exec "$@"
fi

# Stay around to save the login afterwards. A no-op handler (not an ignored
# signal, which the command would inherit) keeps Ctrl-C from killing this
# shell while leaving the command's own signal handling alone.
trap : INT QUIT TERM
"$@"
status=$?

mkdir -p "$profile/out"
[ -f "$home/.claude/.credentials.json" ] &&
    cp "$home/.claude/.credentials.json" "$profile/out/credentials.json"
[ -f "$home/.claude.json" ] &&
    cp "$home/.claude.json" "$profile/out/claude.json"
exit $status
